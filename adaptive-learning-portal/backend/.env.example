# ============================================================
# Adaptive Learning Portal — Environment Configuration Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# Database Configuration
# Default: Local SQLite fallback
DATABASE_URL=sqlite:///./adaptive_portal.db

# Supabase PostgreSQL Database URL (Connection Pooling or Direct)
# Example: postgresql+psycopg2://postgres.uqkkohqascqralvetmxc:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
# Or direct: postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.uqkkohqascqralvetmxc.supabase.co:5432/postgres
SUPABASE_DB_URL=

# Supabase Project Metadata
SUPABASE_PROJECT_REF=uqkkohqascqralvetmxc
SUPABASE_REGION=Tokyo
SUPABASE_URL=https://uqkkohqascqralvetmxc.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Server Host & Port
PORT=8000
HOST=0.0.0.0

# Optional LLM Key for Viva (if left empty, deterministic rubric evaluator is used)
OPENAI_API_KEY=
GEMINI_API_KEY=
